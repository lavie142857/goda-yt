{
  "appId": "com.flashmedia.app",
  "productName": "FLASH MEDIA",
  "directories": {
    "buildResources": "public",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "bin",
      "to": "bin"
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "lavie142857",
      "repo": "goda-yt"
    }
  ],
  "win": {
    "icon": "public/icon.ico",
    "forceCodeSigning": false,
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  }
}

