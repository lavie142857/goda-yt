{
  "appId": "com.flashmedia.app",
  "productName": "FLASH MEDIA",
  "directories": {
    "buildResources": "public",
    "output": "release"
  },
  "artifactName": "FLASH-MEDIA-Setup-${version}.${ext}",
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "bin",
      "to": "bin"
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "lavie142857",
      "repo": "goda-yt"
    }
  ],
  "win": {
    "icon": "public/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "FLASH MEDIA"
  }
}
